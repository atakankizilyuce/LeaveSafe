{
    "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
    "files": {
        "includes": [
            "web/src/**/*.ts",
            "web/src/**/*.tsx",
            "web/public/**/*.js",
            "web/*.ts",
            "!web/dist",
            "!web/node_modules"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 110,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "correctness": {
                "noInnerDeclarations": "off"
            },
            "suspicious": {
                "noRedundantUseStrict": "off"
            },
            "style": {
                "useTemplate": "off"
            },
            "complexity": {
                "useArrowFunction": "off",
                "useOptionalChain": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        },
        "globals": ["self", "caches", "clients", "importScripts"]
    }
}
