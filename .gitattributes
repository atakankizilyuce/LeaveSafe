# Normalize all text files to LF in the repository and in the working tree.
# Without this, Windows checkouts commit CRLF and `gofmt -l` fails on Linux CI.
* text=auto eol=lf

# Explicit rules for the file types in this repo.
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
Makefile  text eol=lf
LICENSE   text eol=lf

# Shell scripts must stay LF to remain executable on Unix.
*.sh      text eol=lf

# Windows-only scripts keep CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Never touch binaries.
*.exe     binary
*.dll     binary
*.dylib   binary
*.so      binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.woff    binary
*.woff2   binary
*.ttf     binary
