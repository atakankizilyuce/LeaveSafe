# Homebrew formula for LeaveSafe. Generated by packaging/generate.sh — edit the
# template in packaging/templates/, not this file.
class Leavesafe < Formula
  desc "Turn your phone into a remote alarm for your laptop"
  homepage "https://github.com/atakankizilyuce/LeaveSafe"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "@BASE@/leavesafe-darwin-arm64"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "@BASE@/leavesafe-darwin-amd64"
      sha256 "@SHA_DARWIN_AMD64@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE@/leavesafe-linux-arm64"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "@BASE@/leavesafe-linux-amd64"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    # The release assets are bare executables named for their platform; install
    # renames to the command users actually type.
    bin.install Dir["leavesafe-*"].first => "leavesafe"
  end

  def caveats
    <<~EOS
      Run `leavesafe` in a terminal, scan the QR code with your phone, and tap Arm.

      To have it start when you log in:
        leavesafe install-service

      Settings, logs and the event history live in ~/.leavesafe.
    EOS
  end

  test do
    assert_match "LeaveSafe", shell_output("#{bin}/leavesafe -version")
  end
end
