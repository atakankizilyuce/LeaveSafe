{
    "$comment": "Scoop manifest for LeaveSafe. Generated by packaging/generate.sh — edit the template in packaging/templates/, not this file.",
    "version": "@VERSION@",
    "description": "Turn your phone into a remote alarm for your laptop. No cloud, no accounts.",
    "homepage": "https://github.com/atakankizilyuce/LeaveSafe",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "@BASE@/leavesafe-windows-amd64.exe#/leavesafe.exe",
            "hash": "@SHA_WINDOWS_AMD64@"
        }
    },
    "bin": "leavesafe.exe",
    "notes": [
        "Run 'leavesafe' in a terminal, scan the QR code with your phone, and tap Arm.",
        "",
        "To have it start when you log in:",
        "  leavesafe install-service",
        "",
        "Settings, logs and the event history live in %APPDATA%\\LeaveSafe."
    ],
    "checkver": {
        "github": "https://github.com/atakankizilyuce/LeaveSafe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/atakankizilyuce/LeaveSafe/releases/download/v$version/leavesafe-windows-amd64.exe#/leavesafe.exe"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
